{
  "name": "zamar-sync",
  "version": "0.5.0",
  "private": true,
  "description": "Apresenta\u00e7\u00e3o offline de letras, B\u00edblia e cifras",
  "author": "Zamar Sync",
  "license": "UNLICENSED",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/licenses.cjs && tsc -p tsconfig.main.json && vite build",
    "check": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test tests/*.test.cjs",
    "pack:linux": "npm run build && electron-builder --linux AppImage tar.gz --x64",
    "pack:win": "npm run build && electron-builder --win zip --x64",
    "licenses": "node scripts/licenses.cjs",
    "test:electron": "node tests/electron-smoke.cjs",
    "pack:linux:dir": "npm run build && electron-builder --linux dir --x64"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "br.zamarsync.app",
    "productName": "Zamar Sync",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "zip",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Utility"
    },
    "artifactName": "zamar-sync-${version}-${os}-${arch}.${ext}",
    "extraFiles": [
      "THIRD_PARTY_NOTICES.txt"
    ]
  }
}
