{
  "name": "zamar-sync",
  "version": "1.0.0",
  "private": true,
  "description": "Apresentação offline de letras, Bíblia e cifras",
  "author": "Zamar Sync",
  "license": "UNLICENSED",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/licenses.cjs && tsc -p tsconfig.main.json && vite build && node scripts/release-manifest.cjs",
    "check": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test tests/*.test.cjs",
    "pack:linux": "npm run build && electron-builder --linux AppImage tar.gz --x64",
    "pack:win": "npm run build && electron-builder --win zip --x64",
    "licenses": "node scripts/licenses.cjs",
    "test:performance": "node tests/quality.cjs",
    "test:qualification": "node tests/electron-smoke.cjs --qualification",
    "test:electron": "node tests/electron-smoke.cjs",
    "pack:linux:dir": "npm run build && electron-builder --linux dir --x64",
    "test:upgrade": "node tests/release-upgrade.cjs",
    "verify:release": "node scripts/verify-release.cjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "br.zamarsync.app",
    "productName": "Zamar Sync",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "zip",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Utility"
    },
    "artifactName": "zamar-sync-${version}-${os}-${arch}.${ext}",
    "extraFiles": [
      "THIRD_PARTY_NOTICES.txt",
      {
        "from": "docs/guia-rapido.md",
        "to": "GUIA-RAPIDO.md"
      },
      {
        "from": "docs/atualizacao-e-recuperacao.md",
        "to": "ATUALIZACAO.md"
      },
      {
        "from": ".release-metadata/COMPONENTS.json",
        "to": "COMPONENTS.json"
      },
      {
        "from": ".release-metadata/BUILD-MANIFEST.json",
        "to": "BUILD-MANIFEST.json"
      }
    ],
    "asarUnpack": [
      "dist/main/bible-worker.js",
      "dist/main/bible-parser.js",
      "dist/shared/**"
    ]
  }
}
